<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store requires the App Sandbox. Applied only to the Catalyst
	     build via CODE_SIGN_ENTITLEMENTS[sdk=macosx*] in project.yml; iOS is
	     sandboxed implicitly and its provisioning rejects these macOS keys. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read/write access to folders the user picks in the open panel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Persist that access across relaunches: BookmarkStore creates
	     .withSecurityScope bookmarks, which need this entitlement to resolve. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
